# --- CoinDCX API (required for live; ignored in DRY_RUN) ---
COINDCX_API_KEY=
COINDCX_SECRET_KEY=

# --- Live trading switch ---
# DRY_RUN defaults ON. Live trading requires BOTH of these set exactly as shown.
DRY_RUN=true
# Set to "I_UNDERSTAND_LIVE_TRADING" to actually place real orders.
LIVE_TRADING_CONFIRM=

# --- Twilio WhatsApp alerts (optional; if unset, alerts just log) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
