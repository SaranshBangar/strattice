# --- CoinDCX API (required for live; ignored in DRY_RUN) ---
COINDCX_API_KEY=
COINDCX_SECRET_KEY=

# --- Live trading switch ---
# DRY_RUN defaults ON. Live trading requires BOTH of these set exactly as shown.
DRY_RUN=true
# Set to "I_UNDERSTAND_LIVE_TRADING" to actually place real orders.
LIVE_TRADING_CONFIRM=

# --- Telegram alerts (optional; if unset, alerts just log) ---
# Token from @BotFather; chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trade emails via the Strattice web app (optional; all three required) ---
# The bot POSTs each fill to the app, which emails NOTIFY_EMAIL. See ENV.md.
STRATTICE_URL=https://strattice.in
INTERNAL_API_KEY=            # must equal the web app's INTERNAL_API_KEY
NOTIFY_EMAIL=
