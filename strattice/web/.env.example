# Next.js platform app. Copy to .env.local. Shares D1 + the encryption key with the worker.

# Better Auth
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=

# Google OAuth. Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare D1 (same DB the Python supervisor uses). Token needs D1 Edit.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# AES-256-GCM key for CoinDCX credentials - MUST equal the worker's ENCRYPTION_MASTER_KEY.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=

# Cashfree Subscriptions (Phase 3). Dashboard > Developers > API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox          # sandbox | production
CASHFREE_API_VERSION=2025-01-01
# Configure the webhook URL in the Cashfree dashboard -> https://<your-app>/api/cashfree/webhook

# Email (native SMTP, no third-party lib). Port 465 = implicit TLS; 587/25 = STARTTLS.
# If unset, emails are silently skipped (safe for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@strattice.in
SMTP_FROM_NAME=Strattice

# Shared secret the Python supervisor uses to POST trade fills to /api/internal/notify
# (buy/sell alerts). Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# Telegram alerts (optional). One bot for the whole platform - token from @BotFather.
# Each user saves their own chat id in Account → Notifications. If unset, Telegram sends
# are skipped (users can still save an id; email alerts are unaffected).
TELEGRAM_BOT_TOKEN=

# Search-engine ownership verification (optional). Paste the token value only.
# Google: Search Console > add property strattice.in > HTML tag method > copy the
#   content="..." value. Emits <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=
# Bing: Webmaster Tools > add site > Meta tag > copy the content value.
BING_SITE_VERIFICATION=
