# Passphrase to unlock the dashboard (single user gate)
APP_PASSPHRASE=change-me

# The bot's read-only status server (bot/server.py), reachable from Vercel.
# Use the permanent ngrok free static domain (see deploy/TUNNEL.md).
BOT_API_URL=https://you.ngrok-free.app
BOT_API_TOKEN=match-bot-BOT_API_TOKEN

# Passkey storage. On Vercel, provision a KV (Upstash Redis) store and connect
# it to the project — Vercel injects KV_REST_API_URL/KV_REST_API_TOKEN itself.
# Without these, passkeys fall back to a local JSON file (dev only); the
# passphrase above always works as backup.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
