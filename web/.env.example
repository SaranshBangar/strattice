# Passphrase to unlock the dashboard (single user gate)
APP_PASSPHRASE=change-me

# The bot's read-only status server (bot/server.py), reachable from Vercel.
# Use the permanent ngrok free static domain (see deploy/TUNNEL.md).
BOT_API_URL=https://you.ngrok-free.app
BOT_API_TOKEN=match-bot-BOT_API_TOKEN
