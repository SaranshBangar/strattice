[Unit]
# Permanent ngrok tunnel exposing the status server at a fixed ngrok-free.app URL.
# Survives reboots/sleep once `systemctl enable`d — no terminal needed.
Description=ngrok tunnel for CoinDCX bot status server
After=network-online.target coindcx-status.service
Wants=network-online.target

[Service]
Type=simple
# Replace the static URL with the one you reserved in the ngrok dashboard.
# Adjust the binary path if ngrok is elsewhere (`which ngrok`).
ExecStart=/usr/local/bin/ngrok http 8787 --url=https://YOUR-STATIC.ngrok-free.app --log=stdout
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
