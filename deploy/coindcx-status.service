[Unit]
# Read-only JSON status server for the dashboard PWA. Sits next to coindcx-bot.
Description=CoinDCX bot status server (read-only JSON for the PWA)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/coindcx
# Set a strong token and keep it identical to the PWA's BOT_API_TOKEN on Vercel.
Environment=BOT_API_TOKEN=CHANGE_ME
Environment=BOT_API_HOST=127.0.0.1
Environment=BOT_API_PORT=8787
ExecStart=/opt/coindcx/.venv/bin/python -m bot.server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
