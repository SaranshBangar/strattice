# Platform env (shared by the Python supervisor now; the Next.js app reads the same DB + key).
# Copy to platform/.env and fill in. NEVER commit the real file.

# Cloudflare D1 (the integration boundary). Token needs D1 Edit. Find IDs in the CF dashboard
# or: wrangler d1 list / wrangler d1 info <DB>.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# 32-byte AES-256 key, base64. Generate once and share with Next.js (it encrypts the keys you decrypt):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=

# Supervisor poll interval seconds (how often it reconciles engines + publishes status).
SUPERVISOR_POLL=30
