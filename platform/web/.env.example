# Next.js platform app. Copy to .env.local. Shares D1 + the encryption key with the worker.

# Better Auth
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare D1 (same DB the Python supervisor uses). Token needs D1 Edit.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# AES-256-GCM key for CoinDCX credentials — MUST equal the worker's ENCRYPTION_MASTER_KEY.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=

# Cashfree Subscriptions (Phase 3). Dashboard > Developers > API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=sandbox          # sandbox | production
CASHFREE_API_VERSION=2025-01-01
# Configure the webhook URL in the Cashfree dashboard -> https://<your-app>/api/cashfree/webhook
